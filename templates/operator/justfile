opentofu_dir := "infra/opentofu"
operator_secrets := "secrets/operator.yaml"
known_hosts := justfile_directory() / "known_hosts"
tailnet_join_timeout := "600"
tofu := "env -u TAILSCALE_OAUTH_CLIENT_ID -u TAILSCALE_OAUTH_CLIENT_SECRET tofu -chdir=" + opentofu_dir
pinned_host_key := "-o " + quote('UserKnownHostsFile="' + known_hosts + '"') + " -o GlobalKnownHostsFile=/dev/null -o KnownHostsCommand=none -o UpdateHostKeys=no -o StrictHostKeyChecking=yes -o CheckHostIP=no"

standup:
    #!/usr/bin/env bash
    set -euo pipefail
    join_timeout={{ quote(tailnet_join_timeout) }}
    if ! [[ "$join_timeout" =~ ^[0-9]+$ ]]; then
        echo "error: tailnet_join_timeout must be a whole number of seconds, not '${join_timeout}', so standup stopped before creating anything." >&2
        exit 1
    fi
    host="$(nix eval --json .#lib.reflect)"
    hostname="$(jq -r '.hostname' <<<"$host")"
    admin_user="$(jq -r '.adminUser' <<<"$host")"
    ssh_port="$(jq -r '.sshPort' <<<"$host")"
    extra_files="$(mktemp -d)"
    trap 'rm -rf "$extra_files"' EXIT
    install -d -m 755 "$extra_files/etc/ssh"
    host_key="$extra_files/etc/ssh/ssh_host_ed25519_key"
    if ! (umask 077 && sops decrypt --extract '["ssh_host_ed25519_key"]' secrets/host.yaml >"$host_key"); then
        echo "error: could not decrypt the box's host key from secrets/host.yaml, so standup stopped before creating anything." >&2
        echo "  Check that the file exists and that your age key is one of its recipients." >&2
        exit 1
    fi
    sops exec-env --same-process {{ operator_secrets }} '{{ tofu }} init -input=false'
    sops exec-env --same-process {{ operator_secrets }} '{{ tofu }} apply'
    ip="$({{ quote(just_executable()) }} _address)"
    if [ -z "$ip" ]; then
        echo "error: OpenTofu applied but reports no server address to install onto." >&2
        exit 1
    fi
    logs_in() {
        {{ quote(just_executable()) }} _connect "$1" "$hostname" "$ssh_port" "$admin_user" -o BatchMode=yes -o ConnectTimeout=5 -o LogLevel=ERROR \
            -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes true </dev/null 2>/dev/null
    }
    for target in "$hostname" "$ip"; do
        if logs_in "$target"; then
            echo "error: ${hostname} is already installed, since an admin login works at ${target}, and standup would reformat its disk." >&2
            echo "  To apply a config change and keep the box's state, run 'just deploy'." >&2
            echo "  For a fresh box, run 'just teardown' then 'just standup'." >&2
            exit 1
        fi
    done
    if ! {{ quote(just_executable()) }} _forget_tailnet_device "$hostname" refuse; then
        echo "error: the old ${hostname} device was not deleted from the tailnet, so standup stopped before installing." >&2
        echo "  If the box is installed, run 'just deploy' to apply a config change and keep its state." >&2
        echo "  If its old server was just destroyed, wait a minute for the device to go offline, then run 'just standup' again." >&2
        exit 1
    fi
    nixos-anywhere --flake ".#${hostname}" --target-host "root@${ip}" --build-on remote --extra-files "$extra_files"
    deadline=$((SECONDS + 10#$join_timeout))
    until logs_in "$hostname"; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "error: ${hostname} was installed but did not join the tailnet within ${join_timeout} seconds." >&2
            exit 1
        fi
        sleep 5
    done

deploy:
    #!/usr/bin/env bash
    set -euo pipefail
    host="$(nix eval --json .#lib.reflect)"
    hostname="$(jq -r '.hostname' <<<"$host")"
    target="$(jq -r '.adminUser' <<<"$host")@${hostname}"
    NIX_SSHOPTS={{ quote(pinned_host_key) }}" -o HostKeyAlias=${hostname} -p $(jq -r '.sshPort' <<<"$host")" nixos-rebuild switch --flake ".#${hostname}" --target-host "$target" --build-host "$target" --sudo

teardown:
    #!/usr/bin/env bash
    set -euo pipefail
    hostname="$(nix eval --raw .#lib.reflect.hostname)"
    if_connected=refuse
    if [ -n "$({{ quote(just_executable()) }} _address)" ]; then
        if_connected=delete
    fi
    sops exec-env --same-process {{ operator_secrets }} '{{ tofu }} destroy'
    if ! {{ quote(just_executable()) }} _forget_tailnet_device "$hostname" "$if_connected"; then
        if [ "$if_connected" = delete ]; then
            echo "error: the server is destroyed, but its ${hostname} device was not deleted from the tailnet. Run 'just teardown' again once that is fixed." >&2
        else
            echo "error: OpenTofu had no server to destroy, so the ${hostname} device was left on the tailnet." >&2
            echo "  Check the Hetzner console for a server OpenTofu has lost track of before removing the device by hand." >&2
        fi
        exit 1
    fi

[positional-arguments]
ssh *args:
    #!/usr/bin/env bash
    set -euo pipefail
    host="$(nix eval --json .#lib.reflect)"
    hostname="$(jq -r '.hostname' <<<"$host")"
    admin_user="$(jq -r '.adminUser' <<<"$host")"
    ssh_port="$(jq -r '.sshPort' <<<"$host")"
    exec {{ quote(just_executable()) }} _connect "$hostname" "$hostname" "$ssh_port" "$admin_user" "$@"

[positional-arguments]
_connect $target $hostname $ssh_port $admin_user *args:
    #!/usr/bin/env bash
    set -euo pipefail
    exec ssh {{ pinned_host_key }} -o "HostKeyAlias=${hostname}" -o ControlMaster=no -o ControlPath=none -p "$ssh_port" "${admin_user}@${target}" "${@:5}"

_forget_tailnet_device $hostname $if_connected:
    sops exec-env --same-process {{ operator_secrets }} {{ quote("env -u HCLOUD_TOKEN " + quote(just_executable()) + ' _delete_tailnet_device "$hostname" "$if_connected"') }}

_delete_tailnet_device $hostname $if_connected:
    #!/usr/bin/env bash
    set -euo pipefail
    api=https://api.tailscale.com/api/v2
    refused() {
        echo "error: the old ${hostname} device could not be cleared through the Tailscale API." >&2
        echo "  Check TAILSCALE_OAUTH_CLIENT_ID and TAILSCALE_OAUTH_CLIENT_SECRET in {{ operator_secrets }}." >&2
        exit 1
    }
    access_token="$(printf '%s' "$TAILSCALE_OAUTH_CLIENT_SECRET" |
        curl -fsS --data-urlencode "client_id=${TAILSCALE_OAUTH_CLIENT_ID}" --data-urlencode client_secret@- "$api/oauth/token" |
        jq -er '.access_token')" || refused
    tailscale_api() {
        printf 'header = "Authorization: Bearer %s"\n' "$access_token" | curl -fsS --config - "$@"
    }
    devices="$(tailscale_api "$api/tailnet/-/devices" |
        jq -c --arg hostname "$hostname" '[.devices[] | select(any(.tags[]?; . == "tag:forge") and (.name | split(".")[0]) == $hostname)]')" || refused
    if [ "$if_connected" != delete ] && jq -e 'any(.[]; .connectedToControl != false)' <<<"$devices" >/dev/null; then
        echo "error: the ${hostname} device is still connected to the tailnet, so it may be a running box and was not deleted." >&2
        exit 1
    fi
    for node_id in $(jq -r '.[].nodeId' <<<"$devices"); do
        tailscale_api -X DELETE "$api/device/${node_id}" >/dev/null || refused
        echo "Deleted the old ${hostname} device ${node_id} from the tailnet."
    done

_address:
    #!/usr/bin/env bash
    set -euo pipefail
    sops exec-env --same-process {{ operator_secrets }} '{{ tofu }} output -json' | jq -r '.server_ipv4.value // empty'
