opentofu_dir := "infra/opentofu"
operator_secrets := "secrets/operator.yaml"
known_hosts := justfile_directory() / "known_hosts"
tailnet_join_timeout := "600"
pinned_host_key := "-o " + quote('UserKnownHostsFile="' + known_hosts + '"') + " -o GlobalKnownHostsFile=/dev/null -o KnownHostsCommand=none -o UpdateHostKeys=no -o StrictHostKeyChecking=yes -o CheckHostIP=no"

standup:
    #!/usr/bin/env bash
    set -euo pipefail
    join_timeout={{ quote(tailnet_join_timeout) }}
    if ! [[ "$join_timeout" =~ ^[0-9]+$ ]]; then
        echo "error: tailnet_join_timeout must be a whole number of seconds, not '${join_timeout}', so standup stopped before creating anything." >&2
        exit 1
    fi
    host="$(nix eval --json .#lib.reflect)"
    hostname="$(jq -r '.hostname' <<<"$host")"
    admin_user="$(jq -r '.adminUser' <<<"$host")"
    ssh_port="$(jq -r '.sshPort' <<<"$host")"
    extra_files="$(mktemp -d)"
    trap 'rm -rf "$extra_files"' EXIT
    install -d -m 755 "$extra_files/etc/ssh"
    host_key="$extra_files/etc/ssh/ssh_host_ed25519_key"
    if ! (umask 077 && sops decrypt --extract '["ssh_host_ed25519_key"]' secrets/host.yaml >"$host_key"); then
        echo "error: could not decrypt the box's host key from secrets/host.yaml, so standup stopped before creating anything." >&2
        echo "  Check that the file exists and that your age key is one of its recipients." >&2
        exit 1
    fi
    sops exec-env --same-process {{ operator_secrets }} 'tofu -chdir={{ opentofu_dir }} init -input=false'
    sops exec-env --same-process {{ operator_secrets }} 'tofu -chdir={{ opentofu_dir }} apply'
    ip="$({{ quote(just_executable()) }} _address)"
    if [ -z "$ip" ]; then
        echo "error: OpenTofu applied but reports no server address to install onto." >&2
        exit 1
    fi
    logs_in() {
        {{ quote(just_executable()) }} _connect "$1" "$hostname" "$ssh_port" "$admin_user" -o BatchMode=yes -o ConnectTimeout=5 -o LogLevel=ERROR \
            -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes true </dev/null 2>/dev/null
    }
    for target in "$hostname" "$ip"; do
        if logs_in "$target"; then
            echo "error: ${hostname} is already installed, since an admin login works at ${target}, and standup would reformat its disk." >&2
            echo "  To apply a config change and keep the box's state, run 'just deploy'." >&2
            echo "  For a fresh box, run 'just teardown' then 'just standup'." >&2
            exit 1
        fi
    done
    nixos-anywhere --flake ".#${hostname}" --target-host "root@${ip}" --build-on remote --extra-files "$extra_files"
    deadline=$((SECONDS + 10#$join_timeout))
    until logs_in "$hostname"; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "error: ${hostname} was installed but did not join the tailnet within ${join_timeout} seconds." >&2
            exit 1
        fi
        sleep 5
    done

deploy:
    #!/usr/bin/env bash
    set -euo pipefail
    host="$(nix eval --json .#lib.reflect)"
    hostname="$(jq -r '.hostname' <<<"$host")"
    target="$(jq -r '.adminUser' <<<"$host")@${hostname}"
    NIX_SSHOPTS={{ quote(pinned_host_key) }}" -o HostKeyAlias=${hostname} -p $(jq -r '.sshPort' <<<"$host")" nixos-rebuild switch --flake ".#${hostname}" --target-host "$target" --build-host "$target" --sudo

teardown:
    sops exec-env --same-process {{ operator_secrets }} 'tofu -chdir={{ opentofu_dir }} destroy'

[positional-arguments]
ssh *args:
    #!/usr/bin/env bash
    set -euo pipefail
    host="$(nix eval --json .#lib.reflect)"
    hostname="$(jq -r '.hostname' <<<"$host")"
    admin_user="$(jq -r '.adminUser' <<<"$host")"
    ssh_port="$(jq -r '.sshPort' <<<"$host")"
    exec {{ quote(just_executable()) }} _connect "$hostname" "$hostname" "$ssh_port" "$admin_user" "$@"

[positional-arguments]
_connect $target $hostname $ssh_port $admin_user *args:
    #!/usr/bin/env bash
    set -euo pipefail
    exec ssh {{ pinned_host_key }} -o "HostKeyAlias=${hostname}" -o ControlMaster=no -o ControlPath=none -p "$ssh_port" "${admin_user}@${target}" "${@:5}"

_address:
    #!/usr/bin/env bash
    set -euo pipefail
    sops exec-env --same-process {{ operator_secrets }} 'tofu -chdir={{ opentofu_dir }} output -json' | jq -r '.server_ipv4.value // empty'
